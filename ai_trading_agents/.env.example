# ═══════════════════════════════════════════════════════
# AI TRADING AGENTS — API Keys Configuration
# Copy this file to .env and fill in your actual API keys
# ═══════════════════════════════════════════════════════

# Groq API (Llama 3.3 70B — FREE tier, 30 req/min)
GROQ_API_KEY=gsk_your_groq_key_here

# Google Gemini API Keys (Multiple keys for higher quota)
# Get keys from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY_1=your_gemini_key_1
GEMINI_API_KEY_2=your_gemini_key_2
GEMINI_API_KEY_3=your_gemini_key_3

# xAI Grok API
XAI_API_KEY=xai-your_key_here

# OpenRouter API (DeepSeek, Nemotron, etc.)
OPENROUTER_API_KEY_1=sk-or-your_key_here
OPENROUTER_API_KEY_2=sk-or-your_key_here

# MT5 Credentials (shared with config/.env)
MT5_LOGIN=your_mt5_account_number
MT5_PASSWORD=your_mt5_password
MT5_SERVER=OctaFX-Demo

# ═══════════════════════════════════════════════════════
# TELEGRAM NOTIFICATIONS (Optional)
# ═══════════════════════════════════════════════════════
# Get bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Get chat ID by sending a message to your bot and checking updates
TELEGRAM_CHAT_ID=your_chat_id_here
# Enable/disable Telegram notifications
TELEGRAM_ENABLED=false
