# Python
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/
.mypy_cache/

# Environment & Credentials (NEVER commit these)
config/.env
ai_trading_agents/.env
.env
.env.*
!.env.example

# Runtime / logs (auto-generated, can be large)
logs/
!logs/.gitkeep
*.log
*.err
*.out
*.pid
supervisor.log

# State / memory files (per-run, not source)
**/agent_memory.json
**/agent_learnings*.json
**/prediction_memory.json
**/agent_internet_research.json
**/agent_training_data.json
**/brain_memory.json
**/bot_state.json
**/trendmaster_signals.json
*.bak

# Historical data & backtest output — too large for git
data/*.csv
!data/.gitkeep
data/external/*.parquet
data/external/*.csv
!data/external/.gitkeep
backtest_results.txt
reports/*.csv
reports/*.json

# Models (registry artifacts)
models/
!models/.gitkeep

# MetaTrader compiled binaries (source .mq5 is committed)
*.ex5

# Test scratch
ai_trading_agents/agent_out.txt
ai_trading_agents/agent_err.txt
ai_trading_agents/test_out.txt
ai_trading_agents/test_error.txt
ai_trading_agents/test_output.txt
tests/test_out.txt

# OS / IDE
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
mt5_dialog_state.png
# Added by code-review-graph
.code-review-graph/

# Auto-generated interactive graph visualization (2 MB, regenerated on
# every rebuild — don't track). Regenerate with:
#   code-review-graph visualize --mode community --format html
docs/code_review_graph.html

# OneDrive ghost copies. The `autmated trading` folder sits under
# Documents\ which OneDrive syncs; it caches an older snapshot where
# ai_trading_agents/*.py had been moved into archive/legacy_python/,
# and keeps re-creating those copies. The authoritative sources are in
# ai_trading_agents/; these duplicates are noise. Gitignoring keeps
# `git status` clean while OneDrive does its thing.
archive/legacy_python/
archive/legacy_state/

# LightGBM model binaries that tooling writes next to the brain.
# Retrain produces them; we only check in the registry.json manifest.
ai_trading_agents/*.lgb
ai_trading_agents/trend_master_model*.lgb

# Third-party binaries (downloadable tools, not project source — keep repo lean)
tools/cloudflared.exe
tools/ngrok.exe

# Browser profiles captured by tv_alert_setup (contain session cookies / cached
# creds) — NEVER commit these.
tools/tv_alert_setup/_browser_profile/
tools/tv_alert_setup/_archive/_browser_profile/
