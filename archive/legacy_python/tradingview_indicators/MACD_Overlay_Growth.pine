// ============================================================================
// MACD OVERLAY — Growth Signal Engine
// ============================================================================
// AI Trading Agents System — TradingView Indicator
// Matches: MACD Overlay (50, 21, 22) from chart setup
// Works on: XAUUSD, XAGUSD, EURUSD, GBPUSD, USDJPY, BTCUSD, ETHUSD (all teams)
// Timeframes: H1, H4
// ============================================================================

//@version=5
indicator("AI Agents — MACD Overlay Growth", shorttitle="MACD OVL", overlay=true, max_labels_count=500, max_bars_back=500)

// ── INPUTS ──────────────────────────────────────────────────────────────────
grp_macd   = "MACD Settings"
fastLen    = input.int(50,  "Fast Length",   minval=1, group=grp_macd)
slowLen    = input.int(21,  "Slow Length",   minval=1, group=grp_macd)
signalLen  = input.int(22,  "Signal Length", minval=1, group=grp_macd)
src        = input.source(close, "Source", group=grp_macd)

grp_signal = "Signal Settings"
showArrows     = input.bool(true,  "Show Buy/Sell Arrows",     group=grp_signal)
showCloud      = input.bool(true,  "Show MACD Cloud on Price", group=grp_signal)
minHistStrength = input.float(0.0, "Min Histogram Strength",   group=grp_signal, step=0.1)

grp_growth = "Growth Filter"
useGrowthFilter  = input.bool(true,  "Enable Positive Growth Filter", group=grp_growth)
growthLookback   = input.int(20,     "Growth Lookback (bars)",        group=grp_growth, minval=5)
growthThreshold  = input.float(0.0,  "Min Growth % for Signal",      group=grp_growth, step=0.1)

grp_team = "Team / Asset Settings"
teamMode = input.string("Auto", "Team Mode", options=["Auto", "Metals", "Forex", "Crypto"], group=grp_team)

// ── TEAM AUTO-DETECTION ─────────────────────────────────────────────────────
isMetals = syminfo.ticker == "XAUUSD" or syminfo.ticker == "XAGUSD" or str.contains(syminfo.ticker, "XAU") or str.contains(syminfo.ticker, "XAG")
isForex  = syminfo.ticker == "EURUSD" or syminfo.ticker == "GBPUSD" or syminfo.ticker == "USDJPY" or syminfo.ticker == "USDCHF" or syminfo.ticker == "AUDUSD" or syminfo.ticker == "USDCAD" or syminfo.ticker == "NZDUSD" or syminfo.ticker == "GBPJPY" or syminfo.ticker == "EURJPY" or syminfo.ticker == "EURGBP"
isCrypto = syminfo.ticker == "BTCUSD" or syminfo.ticker == "ETHUSD" or str.contains(syminfo.ticker, "BTC") or str.contains(syminfo.ticker, "ETH")

currentTeam = teamMode == "Auto" ? (isMetals ? "Metals" : isForex ? "Forex" : isCrypto ? "Crypto" : "Unknown") : teamMode

// ── MACD CALCULATION ────────────────────────────────────────────────────────
fastEMA    = ta.ema(src, fastLen)
slowEMA    = ta.ema(src, slowLen)
macdLine   = fastEMA - slowEMA
signalLine = ta.ema(macdLine, signalLen)
histogram  = macdLine - signalLine

// ── GROWTH MEASUREMENT ──────────────────────────────────────────────────────
// Measures cumulative positive momentum over lookback period
growthRate    = (src - src[growthLookback]) / src[growthLookback] * 100
isGrowing     = growthRate > growthThreshold
growthStrength = math.abs(growthRate)

// Revenue proxy: cumulative histogram strength (positive = growing revenue potential)
cumulativeHist    = math.sum(histogram, growthLookback)
revenueGrowth     = cumulativeHist > 0
revenueMomentum   = ta.ema(histogram, 10)

// ── SIGNAL GENERATION ───────────────────────────────────────────────────────
bullCross = ta.crossover(macdLine, signalLine)
bearCross = ta.crossunder(macdLine, signalLine)

// Histogram strength filter
histStrong = math.abs(histogram) > minHistStrength

// Growth-filtered signals (positive growth = agent confidence boost)
growthOK = useGrowthFilter ? isGrowing : true

buySignal  = bullCross and histStrong and growthOK
sellSignal = bearCross and histStrong

// Strong signals: MACD cross + histogram expanding + growth positive
strongBuy  = buySignal and histogram > histogram[1] and revenueGrowth
strongSell = sellSignal and histogram < histogram[1] and not revenueGrowth

// ── OVERLAY PLOTTING ────────────────────────────────────────────────────────
// Plot EMAs as overlay reference lines
plot(fastEMA, "Fast EMA", color=color.new(color.blue, 30), linewidth=2)
plot(slowEMA, "Slow EMA", color=color.new(color.orange, 30), linewidth=2)

// MACD cloud between fast and slow EMA
fastAbove = fastEMA >= slowEMA
fillColor = showCloud ? (fastAbove ? color.new(color.green, 85) : color.new(color.red, 85)) : na
p1 = plot(fastEMA, display=display.none)
p2 = plot(slowEMA, display=display.none)
fill(p1, p2, color=fillColor, title="MACD Trend Cloud")

// ── BUY / SELL ARROWS ───────────────────────────────────────────────────────
plotshape(showArrows and strongBuy,  title="Strong BUY",  style=shape.triangleup,   location=location.belowbar, color=color.new(#00E676, 0), size=size.normal, text="BUY")
plotshape(showArrows and strongSell, title="Strong SELL", style=shape.triangledown, location=location.abovebar, color=color.new(#FF1744, 0), size=size.normal, text="SELL")

plotshape(showArrows and buySignal and not strongBuy,   title="Weak BUY",  style=shape.triangleup,   location=location.belowbar, color=color.new(#69F0AE, 0), size=size.small)
plotshape(showArrows and sellSignal and not strongSell, title="Weak SELL", style=shape.triangledown, location=location.abovebar, color=color.new(#FF8A80, 0), size=size.small)

// ── BACKGROUND: GROWTH ZONE ────────────────────────────────────────────────
bgGrowth = isGrowing and revenueGrowth ? color.new(color.green, 95) : not isGrowing and not revenueGrowth ? color.new(color.red, 95) : na
bgcolor(bgGrowth, title="Growth Zone Background")

// ── INFO TABLE ──────────────────────────────────────────────────────────────
var table infoTable = table.new(position.top_right, 2, 7, bgcolor=color.new(#1E1E1E, 10), border_width=1, border_color=color.new(color.gray, 50))

if barstate.islast
    table.cell(infoTable, 0, 0, "AI MACD Overlay", text_color=color.white, text_size=size.small, bgcolor=color.new(#2196F3, 20))
    table.cell(infoTable, 1, 0, str.tostring(fastLen) + "/" + str.tostring(slowLen) + "/" + str.tostring(signalLen), text_color=color.white, text_size=size.small)

    table.cell(infoTable, 0, 1, "Team", text_color=color.gray, text_size=size.tiny)
    table.cell(infoTable, 1, 1, currentTeam, text_color=color.yellow, text_size=size.tiny)

    table.cell(infoTable, 0, 2, "MACD", text_color=color.gray, text_size=size.tiny)
    table.cell(infoTable, 1, 2, str.tostring(math.round(macdLine, 4)), text_color=macdLine > 0 ? color.green : color.red, text_size=size.tiny)

    table.cell(infoTable, 0, 3, "Histogram", text_color=color.gray, text_size=size.tiny)
    table.cell(infoTable, 1, 3, str.tostring(math.round(histogram, 4)), text_color=histogram > 0 ? color.green : color.red, text_size=size.tiny)

    table.cell(infoTable, 0, 4, "Growth %", text_color=color.gray, text_size=size.tiny)
    table.cell(infoTable, 1, 4, str.tostring(math.round(growthRate, 2)) + "%", text_color=isGrowing ? color.green : color.red, text_size=size.tiny)

    table.cell(infoTable, 0, 5, "Revenue Mom.", text_color=color.gray, text_size=size.tiny)
    table.cell(infoTable, 1, 5, revenueGrowth ? "POSITIVE" : "NEGATIVE", text_color=revenueGrowth ? color.green : color.red, text_size=size.tiny)

    table.cell(infoTable, 0, 6, "Signal", text_color=color.gray, text_size=size.tiny)
    sigText = strongBuy ? "STRONG BUY" : strongSell ? "STRONG SELL" : buySignal ? "BUY" : sellSignal ? "SELL" : "HOLD"
    sigCol  = strongBuy ? color.green : strongSell ? color.red : buySignal ? #69F0AE : sellSignal ? #FF8A80 : color.gray
    table.cell(infoTable, 1, 6, sigText, text_color=sigCol, text_size=size.tiny)

// ── ALERTS ──────────────────────────────────────────────────────────────────
alertcondition(strongBuy,  title="Strong BUY Signal",  message="AI Agents MACD: STRONG BUY on {{ticker}} ({{interval}}) — Growth: {{plot_4}}")
alertcondition(strongSell, title="Strong SELL Signal", message="AI Agents MACD: STRONG SELL on {{ticker}} ({{interval}})")
alertcondition(buySignal,  title="BUY Signal",         message="AI Agents MACD: BUY on {{ticker}} ({{interval}})")
alertcondition(sellSignal, title="SELL Signal",        message="AI Agents MACD: SELL on {{ticker}} ({{interval}})")
