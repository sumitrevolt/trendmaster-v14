# OctaFX MetaTrader 5 Credentials
# Copy this file to .env and fill in your credentials
# NEVER commit .env to version control!

# MT5 Account Details (Get from OctaFX demo account)
MT5_LOGIN=your_account_number
MT5_PASSWORD=your_password
MT5_SERVER=OctaFX-Demo

# Account Settings (50,000 INR Investment)
ACCOUNT_BALANCE_INR=50000

# Risk Management Settings (Conservative for 50k INR)
RISK_PERCENT=1.0
MAX_DAILY_DRAWDOWN=5.0
MAX_OPEN_TRADES=2

# Trading Settings
MAGIC_NUMBER=234000
